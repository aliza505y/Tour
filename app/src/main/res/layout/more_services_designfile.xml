<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/backgroud_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/more_services_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/r1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/more_services_name_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Holy Park Hotel"
            android:textSize="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_7sdp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/more_services_image"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/more_services_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:src="@drawable/star_image"
            app:layout_constraintStart_toStartOf="@+id/more_services_name_place"
            app:layout_constraintTop_toBottomOf="@+id/more_services_name_place" />

        <TextView
            android:id="@+id/more_services_num_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.8"
            android:textSize="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/more_services_star"
            app:layout_constraintStart_toEndOf="@+id/more_services_star"
            app:layout_constraintTop_toTopOf="@+id/more_services_star" />

        <ImageView
            android:id="@+id/more_services_map"
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_12sdp"
            android:src="@drawable/white_map"
            android:layout_marginTop="@dimen/_7sdp"
            app:layout_constraintEnd_toEndOf="@+id/more_services_star"
            app:layout_constraintStart_toStartOf="@+id/more_services_star"
            app:layout_constraintTop_toBottomOf="@+id/more_services_star" />

        <TextView
            android:id="@+id/more_services_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cox's Bazar"
            android:textColor="#9D9D9D"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="@+id/more_services_map"
            app:layout_constraintStart_toEndOf="@+id/more_services_map"
            app:layout_constraintTop_toTopOf="@+id/more_services_map" />

        <TextView
            android:id="@+id/more_services_dollar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$122"
            android:textSize="@dimen/_14sdp"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_5sdp"
            app:layout_constraintStart_toStartOf="@+id/more_services_map"
            app:layout_constraintTop_toBottomOf="@+id/more_services_map" />

        <TextView
            android:id="@+id/more_services_dollar_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/Room/Night"
            android:textColor="#696969"
            app:layout_constraintStart_toEndOf="@+id/more_services_dollar"
            app:layout_constraintBottom_toBottomOf="@+id/more_services_dollar"
            app:layout_constraintTop_toTopOf="@+id/more_services_dollar"
            tools:layout_editor_absoluteX="159dp"/>


        <ImageView
            android:id="@+id/more_srervices_saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:src="@drawable/saveeed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- g button ha ye dynamic mn
        aay ga ya static data mn?
      static-->
        <!--ye confusion tu clear ha na k
        konsi jga py dynamic aur static views
        use kr jo data user change na kr sky han button ka text all time
        book now rhy ga so ye asy he addkrdy design my
        ek task ha abi krna
        konsab
        book know button click ho tu sath
        image , hotel nam e, rating , price next
        activity per send kro aur waha set kro ye det agy wohi name jay jis py
         clicjk kr rhy hon data enter kr k get krna ha?han sai-->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/more_services_book"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_23sdp"
            android:background="@drawable/backgroud_white"
            android:textAllCaps="false"
            android:backgroundTint="#F75D37"
            android:text="Book Now"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:gravity="center"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>