<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Chat_Fragment">

    <ImageView
        android:id="@+id/back_arrow_chats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/left_arrow"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_30sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/chat_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chat"
        android:textSize="@dimen/_15sdp"
        android:layout_marginStart="@dimen/_110sdp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/back_arrow_chats"
        app:layout_constraintStart_toEndOf="@+id/back_arrow_chats"
        app:layout_constraintTop_toTopOf="@+id/back_arrow_chats" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/conversation_button"
        android:layout_width="@dimen/_130sdp"
        android:layout_height="@dimen/_45sdp"
        android:layout_marginTop="@dimen/_25sdp"
        android:backgroundTint="#F75D37"
        android:text="Conversations"
        android:layout_marginStart="@dimen/_20sdp"
        android:textSize="@dimen/_13sdp"
        app:cornerRadius="@dimen/_10sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/back_arrow_chats" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/all_friend_button"
        android:layout_width="@dimen/_130sdp"
        android:layout_height="@dimen/_45sdp"
        android:backgroundTint="@color/white"
        android:text="All Friend"
        android:layout_marginEnd="@dimen/_20sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        app:cornerRadius="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="@+id/conversation_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/conversation_button"
        app:layout_constraintVertical_bias="1.0" />

    <EditText
        android:id="@+id/search_any_chats"
        android:layout_width="@dimen/_290sdp"
        android:layout_height="@dimen/_37sdp"
        android:background="@drawable/chat_search_back"
        android:drawableStart="@drawable/chat_search"
        android:drawablePadding="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:hint="Search any chats..."
        android:paddingStart="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="@+id/all_friend_button"
        app:layout_constraintStart_toStartOf="@+id/conversation_button"
        app:layout_constraintTop_toBottomOf="@+id/conversation_button" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recyclerview"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_any_chats" />

</androidx.constraintlayout.widget.ConstraintLayout>