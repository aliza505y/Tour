<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Most_Visited">

    <ImageView
        android:id="@+id/back_arrow_most_visited"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/left_arrow"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_30sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/most_visited_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Most Visited"
        android:layout_marginStart="@dimen/_80sdp"
        android:textSize="@dimen/_15sdp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/back_arrow_most_visited"
        app:layout_constraintStart_toEndOf="@+id/back_arrow_most_visited"
        app:layout_constraintTop_toTopOf="@+id/back_arrow_most_visited" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/most_visited_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/most_visited_screen" />
</androidx.constraintlayout.widget.ConstraintLayout>