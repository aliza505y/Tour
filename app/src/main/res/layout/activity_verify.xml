<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Verify">

    <ImageView
        android:id="@+id/back_arrow_verify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/left_arrow"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_30sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/verify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify"
        android:textSize="@dimen/_15sdp"
        android:textStyle="bold"
        android:layout_marginStart="@dimen/_100sdp"
        app:layout_constraintBottom_toBottomOf="@+id/back_arrow_verify"
        app:layout_constraintStart_toEndOf="@+id/back_arrow_verify"
        app:layout_constraintTop_toTopOf="@+id/back_arrow_verify" />

    <ImageView
        android:id="@+id/verify_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/verify_image"
        android:layout_marginTop="@dimen/_40sdp"
        app:layout_constraintEnd_toEndOf="@+id/verify"
        app:layout_constraintStart_toStartOf="@+id/verify"
        app:layout_constraintTop_toBottomOf="@+id/verify" />

    <TextView
        android:id="@+id/enter_otp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter OTP"
        android:textSize="@dimen/_20sdp"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/_30sdp"
        app:layout_constraintEnd_toEndOf="@+id/verify_image"
        app:layout_constraintStart_toStartOf="@+id/verify_image"
        app:layout_constraintTop_toBottomOf="@+id/verify_image" />

    <TextView
        android:id="@+id/four_digit_otp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#696969"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="An 4 digit OTP has been sent to"
        app:layout_constraintEnd_toEndOf="@+id/enter_otp"
        app:layout_constraintStart_toStartOf="@+id/enter_otp"
        app:layout_constraintTop_toBottomOf="@+id/enter_otp" />

    <TextView
        android:id="@+id/number_8801_verify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+8801712345678"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="@+id/four_digit_otp"
        app:layout_constraintStart_toStartOf="@+id/four_digit_otp"
        app:layout_constraintTop_toBottomOf="@+id/four_digit_otp" />

    <EditText
        android:id="@+id/box_1"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginTop="@dimen/_40sdp"
        android:layout_marginStart="@dimen/_28sdp"
        android:background="@drawable/background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/number_8801_verify" />

    <EditText
        android:id="@+id/box_2"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginStart="@dimen/_20sdp"
        android:background="@drawable/background"
        app:layout_constraintBottom_toBottomOf="@+id/box_1"
        app:layout_constraintStart_toEndOf="@+id/box_1"
        app:layout_constraintTop_toTopOf="@+id/box_1" />

    <EditText
        android:id="@+id/box_3"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginStart="@dimen/_20sdp"
        android:background="@drawable/background"
        app:layout_constraintBottom_toBottomOf="@+id/box_2"
        app:layout_constraintStart_toEndOf="@+id/box_2"
        app:layout_constraintTop_toTopOf="@+id/box_2" />

    <EditText
        android:id="@+id/box_4"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:background="@drawable/background"
        android:layout_marginStart="@dimen/_20sdp"
        app:layout_constraintBottom_toBottomOf="@+id/box_3"
        app:layout_constraintStart_toEndOf="@+id/box_3"
        app:layout_constraintTop_toTopOf="@+id/box_3" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/verify_button"
        android:layout_width="@dimen/_233sdp"
        android:layout_height="@dimen/_35sdp"
        android:background="@drawable/background"
        android:backgroundTint="#F75D37"
        android:text="Verify"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:layout_marginTop="@dimen/_50sdp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/box_4"
        app:layout_constraintStart_toStartOf="@+id/box_1"
        app:layout_constraintTop_toBottomOf="@+id/box_2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/verify"
        android:layout_marginTop="@dimen/_15sdp"
        app:layout_constraintEnd_toEndOf="@+id/verify_button"
        app:layout_constraintStart_toStartOf="@+id/verify_button"
        app:layout_constraintTop_toBottomOf="@+id/verify_button" />


</androidx.constraintlayout.widget.ConstraintLayout>