<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_marginBottom="@dimen/_10sdp"
    android:layout_height="wrap_content">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/_280sdp"
        android:layout_height="wrap_content"
        android:background="@drawable/background"
        android:backgroundTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/places_image"
            android:layout_width="@dimen/_45sdp"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:src="@drawable/sajekvalley"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/valley_name_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_7sdp"
            android:text="Sajek Valley"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/places_image"
            app:layout_constraintTop_toTopOf="@+id/places_image" />

        <ImageView
            android:id="@+id/map_image"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:src="@drawable/map"
            app:layout_constraintStart_toStartOf="@+id/valley_name_place"
            app:layout_constraintTop_toBottomOf="@+id/valley_name_place" />

        <TextView
            android:id="@+id/location_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bandarban, Bangladesh"
            android:textColor="#9D9D9D"
            app:layout_constraintBottom_toBottomOf="@+id/map_image"
            app:layout_constraintStart_toEndOf="@+id/map_image"
            app:layout_constraintTop_toTopOf="@+id/map_image" />

        <ImageView
            android:id="@+id/star_image_places"
            android:layout_width="14dp"
            android:layout_height="15dp"
            android:layout_marginTop="@dimen/_3sdp"
            android:src="@drawable/star_image"
            app:layout_constraintStart_toStartOf="@+id/map_image"
            app:layout_constraintTop_toBottomOf="@+id/map_image" />


        <TextView
            android:id="@+id/stars_numbers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.7"
            android:layout_marginStart="@dimen/_2sdp"
            android:textSize="@dimen/_13sdp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/star_image_places"
            app:layout_constraintStart_toEndOf="@+id/star_image_places"
            app:layout_constraintTop_toTopOf="@+id/star_image_places" />

        <ImageView
            android:id="@+id/saved_Image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_20sdp"
            android:src="@drawable/saved_image"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>