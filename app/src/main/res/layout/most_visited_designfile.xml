<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/backgroud_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/most_visited_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:src="@drawable/visit1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/most_visited_name_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tajhat Jamidarbari"
            android:textSize="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_7sdp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/most_visited_image"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/most_visited_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:src="@drawable/star_image"
            app:layout_constraintStart_toStartOf="@+id/most_visited_name_place"
            app:layout_constraintTop_toBottomOf="@+id/most_visited_name_place" />

        <TextView
            android:id="@+id/most_visited_num_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.8"
            android:textSize="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/most_visited_star"
            app:layout_constraintStart_toEndOf="@+id/most_visited_star"
            app:layout_constraintTop_toTopOf="@+id/most_visited_star" />

        <ImageView
            android:id="@+id/most_visited_map"
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_12sdp"
            android:src="@drawable/white_map"
            android:layout_marginTop="@dimen/_7sdp"
            app:layout_constraintEnd_toEndOf="@+id/most_visited_star"
            app:layout_constraintStart_toStartOf="@+id/most_visited_star"
            app:layout_constraintTop_toBottomOf="@+id/most_visited_star" />

        <TextView
            android:id="@+id/most_visited_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bangladesh"
            android:textColor="#9D9D9D"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="@+id/most_visited_map"
            app:layout_constraintStart_toEndOf="@+id/most_visited_map"
            app:layout_constraintTop_toTopOf="@+id/most_visited_map" />

        <TextView
            android:id="@+id/most_visited_dollar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$122"
            android:textSize="@dimen/_14sdp"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_5sdp"
            app:layout_constraintStart_toStartOf="@+id/most_visited_map"
            app:layout_constraintTop_toBottomOf="@+id/most_visited_map" />

        <ImageView
            android:id="@+id/most_visited_saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:src="@drawable/saveeed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/most_visited_book"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_23sdp"
            android:background="@drawable/backgroud_white"
            android:backgroundTint="#F75D37"
            android:text="Book Now"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:gravity="center"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>